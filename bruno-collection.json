{
  "info": {
    "name": "BIM InfoTech API",
    "_postman_id": "bim-infotech-collection",
    "description": "Collection for auth, worklog, and office endpoints. Replace {{baseUrl}} and set {{auth_token}} after sign-in.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"bruno@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          }
        },
        {
          "name": "Signin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bruno@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signin"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// If the server returns a token in body, set it; otherwise set manually",
                  "try {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data.token) { pm.environment.set('auth_token', res.data.token); }",
                  "} catch(e) { }",
                  "// You can also copy the cookie 'auth_token' from response headers into env var 'auth_token'"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Worklog",
      "item": [
        {
          "name": "Check In",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "auth_token={{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/worklog/check-in",
              "host": ["{{baseUrl}}"],
              "path": ["worklog", "check-in"]
            }
          }
        },
        {
          "name": "Check Out",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "auth_token={{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/worklog/check-out",
              "host": ["{{baseUrl}}"],
              "path": ["worklog", "check-out"]
            }
          }
        },
        {
          "name": "Take Break",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "auth_token={{auth_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/worklog/take-break",
              "host": ["{{baseUrl}}"],
              "path": ["worklog", "take-break"]
            }
          }
        },
        {
          "name": "Return From Break",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "auth_token={{auth_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/worklog/return-from-break",
              "host": ["{{baseUrl}}"],
              "path": ["worklog", "return-from-break"]
            }
          }
        },
        {
          "name": "Get Today's WorkLog",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "auth_token={{auth_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/worklog/today",
              "host": ["{{baseUrl}}"],
              "path": ["worklog", "today"]
            }
          }
        }
      ]
    },
    {
      "name": "Office",
      "item": [
        {
          "name": "Create Office",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Main Office\",\n  \"latitude\": 40.7128,\n  \"longitude\": -74.0060,\n  \"radiusMeters\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/office",
              "host": ["{{baseUrl}}"],
              "path": ["office"]
            }
          }
        },
        {
          "name": "Get Offices",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/office",
              "host": ["{{baseUrl}}"],
              "path": ["office"]
            }
          }
        },
        {
          "name": "Get Office By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/office/:id",
              "host": ["{{baseUrl}}"],
              "path": ["office", ":id"]
            }
          }
        },
        {
          "name": "Update Office",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Main Office Updated\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/office/:id",
              "host": ["{{baseUrl}}"],
              "path": ["office", ":id"]
            }
          }
        },
        {
          "name": "Delete Office",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/office/:id",
              "host": ["{{baseUrl}}"],
              "path": ["office", ":id"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "auth_token", "value": "" },
    { "key": "latitude", "value": "40.71285" },
    { "key": "longitude", "value": "-74.00595" }
  ]
}
