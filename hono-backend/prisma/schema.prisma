// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  name        String
  role        Role         @default(NEW)
  verified    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  attendances Attendance[]
  workLogs    WorkLog[]
}

model Attendance {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Office {
  id           String   @id @default(uuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Float    @default(10) // Default 10 meter radius
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkLog {
  id            String         @id @default(uuid())
  userId        String
  date          DateTime       @db.Date
  checkinAt     DateTime
  checkinLat    Float
  checkinLng    Float
  checkoutAt    DateTime?
  checkoutLat   Float?
  checkoutLng   Float?
  status        WorkLogStatus  @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  breakSessions BreakSession[]

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model BreakSession {
  id        String    @id @default(uuid())
  worklogId String
  startAt   DateTime
  endAt     DateTime?
  createdAt DateTime  @default(now())

  worklog WorkLog @relation(fields: [worklogId], references: [id])
}

enum WorkLogStatus {
  ACTIVE
  ON_BREAK
  CHECKED_OUT
}

enum Role {
  ADMIN
  MANAGER
  LEAD
  EMPLOYEE
  STUDENT
  NEW
}
